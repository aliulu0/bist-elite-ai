# App
APP_NAME=BIST Elite AI
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=info
SCHEDULER_ENABLED=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bist_elite_ai

# Redis (OPTIONAL — the app runs without it using the in-memory cache fallback)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h
AUTH_ENABLED=true
AUTH_ALLOW_ANONYMOUS=true

# Telegram
# R2-051 — Telegram Daily Opportunity Radar delivery channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_DAILY_RADAR_ENABLED=false
TELEGRAM_DAILY_RADAR_TIME=18:30
TELEGRAM_TIMEZONE=Europe/Istanbul
TELEGRAM_MIN_SCORE=70
TELEGRAM_MAX_OPPORTUNITIES=10
TELEGRAM_INCLUDE_WEAKENING=false
TELEGRAM_INCLUDE_INVALIDATED=false
TELEGRAM_SEND_EMPTY_REPORT=false
TELEGRAM_COOLDOWN_MINUTES=60
TELEGRAM_REQUEST_TIMEOUT_MS=15000
TELEGRAM_MAX_RETRIES=3
TELEGRAM_DRY_RUN=false
TELEGRAM_LIVE_SMOKE_TEST=false

# CORS
CORS_ORIGINS=http://localhost:3000

# ── Market Data Providers ────────────────────────────────────────────────────
# API keys are read from these environment variables. Set them in your local
# `.env` (gitignored) so every process/shell picks them up consistently.
# See `apps/api/src/modules/market-data/config/market-data.config.ts` for the
# full set of per-provider options (priority, timeout, retries, baseUrl).
#
# R2-072: Finnhub and Alpha Vantage were REMOVED from the runtime (verified
# unusable for BIST: Finnhub AUTH_FAILED, Alpha Vantage NO_QUOTE/RATE_LIMITED).

# SerpAPI (financial/news research)
SERPAPI_API_KEY=
SERPAPI_ENABLED=true
SERPAPI_PRIORITY=8
SERPAPI_TIMEOUT_MS=15000
SERPAPI_RETRY_COUNT=2

# Fintables (BIST data, unauthenticated)
FINTABLES_ENABLED=true
FINTABLES_PRIORITY=1
FINTABLES_TIMEOUT_MS=15000
FINTABLES_RETRY_COUNT=3

# Yahoo Finance (public endpoint, no key required)
YAHOO_ENABLED=true
YAHOO_PRIORITY=4
YAHOO_TIMEOUT_MS=15000
YAHOO_RETRY_COUNT=2

# KAP (public endpoint, no key required)
KAP_ENABLED=true
KAP_PRIORITY=5
KAP_TIMEOUT_MS=15000
KAP_RETRY_COUNT=3

# TCMB (public endpoint, no key required)
TCMB_ENABLED=true
TCMB_PRIORITY=6
TCMB_TIMEOUT_MS=15000
TCMB_RETRY_COUNT=3

# MKK (public endpoint, no key required)
MKK_ENABLED=true
MKK_PRIORITY=7
MKK_TIMEOUT_MS=15000
MKK_RETRY_COUNT=3
