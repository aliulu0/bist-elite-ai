# App
APP_NAME=BIST Elite AI
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bist_elite_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# Telegram
# R2-051 — Telegram Daily Opportunity Radar delivery channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_DAILY_RADAR_ENABLED=false
TELEGRAM_DAILY_RADAR_TIME=18:30
TELEGRAM_TIMEZONE=Europe/Istanbul
TELEGRAM_MIN_SCORE=70
TELEGRAM_MAX_OPPORTUNITIES=10
TELEGRAM_INCLUDE_WEAKENING=false
TELEGRAM_INCLUDE_INVALIDATED=false
TELEGRAM_SEND_EMPTY_REPORT=false
TELEGRAM_COOLDOWN_MINUTES=60
TELEGRAM_REQUEST_TIMEOUT_MS=15000
TELEGRAM_MAX_RETRIES=3
TELEGRAM_DRY_RUN=false
TELEGRAM_LIVE_SMOKE_TEST=false

# CORS
CORS_ORIGINS=http://localhost:3000
