# ==========================================================
# BIST Elite AI - Development Environment Variables
# ==========================================================

# App
APP_NAME=BIST Elite AI
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=debug

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bist_elite_ai
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bist_elite_ai
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/bist_elite_ai

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=redis://localhost:6379/0

# Auth
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=24h

# API
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Worker
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_LOG_LEVEL=debug

# Telegram (optional in development)
TELEGRAM_BOT_TOKEN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
