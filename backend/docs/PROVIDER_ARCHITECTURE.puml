@startuml Provider Architecture

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title BIST Elite AI - Provider Architecture

package "providers.models" #F0F0F0 {
    enum ProviderType {
        PRICE
        FINANCIAL
        TECHNICAL
        NEWS
        SECTOR
    }

    enum ProviderStatus {
        ACTIVE
        INACTIVE
        ERROR
        RATE_LIMITED
        UNAVAILABLE
    }

    enum ProviderPriority {
        PRIMARY = 1
        SECONDARY = 2
        FALLBACK = 3
        MOCK = 99
    }

    enum ProviderSource {
        MOCK
        YAHOO_FINANCE
        FINNHUB
        POLYGON
        ALPHA_VANTAGE
        FMP
        KAP
        MATRIKS
        TRADINGVIEW
        FINTABLES
        LOCAL
    }

    class CompanyData {
        +stock_code: str
        +company_name: str
        +sector: str
        +market: str
        +to_dict(): dict
    }

    class PriceData {
        +stock_code: str
        +date: date
        +open: float
        +high: float
        +low: float
        +close: float
        +volume: float
        +turnover: float
        +to_dict(): dict
    }

    class FinancialData {
        +stock_code: str
        +period: str
        +year: int
        +quarter: int
        +revenue: float
        +net_profit: float
        +to_dict(): dict
    }

    class NewsData {
        +title: str
        +content: str
        +source: str
        +to_dict(): dict
    }

    class SectorData {
        +sector: str
        +date: date
        +strength_score: float
        +to_dict(): dict
    }

    class ProviderHealth {
        +status: ProviderStatus
        +latency_ms: float
        +consecutive_failures: int
        +to_dict(): dict
    }

    class ProviderMetrics {
        +total_requests: int
        +successful_requests: int
        +failed_requests: int
        +success_rate: float
        +avg_latency_ms: float
        +record_success(): void
        +record_failure(): void
        +to_dict(): dict
    }
}

package "providers.base" #E8F4FD {
    class ProviderConfig {
        +source: ProviderSource
        +provider_type: ProviderType
        +priority: ProviderPriority
        +api_key: str
        +rate_limit_per_minute: int
        +timeout_seconds: float
        +enabled: bool
    }

    abstract class AbstractProvider {
        <<abstract>>
        -_config: ProviderConfig
        -_connected: bool
        -_health: ProviderHealth
        -_metrics: ProviderMetrics
        --
        +{abstract} connect(): bool
        +{abstract} download(**kwargs): Any
        +{abstract} validate(raw_data): bool
        +{abstract} transform(raw_data): list
        +{abstract} save(data): dict
        +{abstract} health_check(): ProviderHealth
        --
        +execute(): dict
        +disconnect(): void
        +record_success(): void
        +record_failure(): void
        +get_status_dict(): dict
    }

    class ProviderManager {
        -_provider_type: ProviderType
        -_providers: list[AbstractProvider]
        -_state: FailoverState
        --
        +register(provider): void
        +unregister(name): bool
        +get_provider(name): AbstractProvider
        +execute(): dict
        +health_check_all(): dict
        +get_status(): dict
        +reset_failures(): void
    }

    class ProviderRegistry {
        -_managers: dict[ProviderType, ProviderManager]
        --
        +{static} instance: ProviderRegistry
        +get_manager(type): ProviderManager
        +register(provider): void
        +get_active_provider(type): AbstractProvider
        +get_all_status(): dict
        +health_check_all(): dict
        +reset(): void
    }

    class ProviderFactory {
        +{static} create_price_providers(): list
        +{static} create_financial_providers(): list
        +{static} create_news_providers(): list
        +{static} create_sector_providers(): list
        +{static} create_technical_providers(): list
        +{static} create_default_providers(): dict
        +{static} create_single(): AbstractProvider
    }

    class FailoverState {
        -current_index: int
        -failure_counts: dict
        -cooldown_until: dict
    }
}

package "providers.implementations.price" #FFF3E0 {
    class MockPriceProvider {
        +connect(): bool
        +download(): dict
        +validate(): bool
        +transform(): list
        +fetch_companies(): DataFrame
        +fetch_prices(): DataFrame
    }

    class YahooFinancePriceProvider {
        -_client: httpx.AsyncClient
        +connect(): bool
        +download(): dict
        +health_check(): ProviderHealth
    }

    class KapPriceProvider {
        -_client: httpx.AsyncClient
        +connect(): bool
        +download(): dict
        +health_check(): ProviderHealth
    }
}

package "providers.implementations.financial" #E8F5E9 {
    class MockFinancialProvider {
        +connect(): bool
        +download(): dict
        +fetch_financial_reports(): DataFrame
    }

    class KapFinancialProvider {
        -_client: httpx.AsyncClient
        +connect(): bool
        +download(): dict
    }
}

package "providers.implementations.news" #FCE4EC {
    class MockNewsProvider {
        +connect(): bool
        +fetch_news(): DataFrame
    }

    class KapNewsProvider {
        -_client: httpx.AsyncClient
        +connect(): bool
    }
}

package "providers.implementations.sector" #F3E5F5 {
    class MockSectorProvider {
        +connect(): bool
        +fetch_sectors(): DataFrame
    }
}

package "providers.implementations.technical" #E0F7FA {
    class LocalTechnicalProvider {
        +calculate_indicators(): DataFrame
        +connect(): bool
    }
}

' --- Relationships ---

AbstractProvider "1" *-- "1" ProviderConfig : has
AbstractProvider "1" *-- "1" ProviderHealth : has
AbstractProvider "1" *-- "1" ProviderMetrics : has

ProviderManager "1" o-- "0..*" AbstractProvider : manages
ProviderManager "1" *-- "1" FailoverState : has

ProviderRegistry "1" o-- "0..*" ProviderManager : contains
ProviderFactory ..> ProviderRegistry : registers into
ProviderFactory ..> AbstractProvider : creates

MockPriceProvider --|> AbstractProvider
YahooFinancePriceProvider --|> AbstractProvider
KapPriceProvider --|> AbstractProvider
MockFinancialProvider --|> AbstractProvider
KapFinancialProvider --|> AbstractProvider
MockNewsProvider --|> AbstractProvider
KapNewsProvider --|> AbstractProvider
MockSectorProvider --|> AbstractProvider
LocalTechnicalProvider --|> AbstractProvider

MockPriceProvider ..> CompanyData : returns
MockPriceProvider ..> PriceData : returns
YahooFinancePriceProvider ..> PriceData : returns
KapPriceProvider ..> CompanyData : returns
KapPriceProvider ..> PriceData : returns
MockFinancialProvider ..> FinancialData : returns
KapFinancialProvider ..> FinancialData : returns
MockNewsProvider ..> NewsData : returns
KapNewsProvider ..> NewsData : returns
MockSectorProvider ..> SectorData : returns

CompanyData ..> ProviderType : belongs to
PriceData ..> ProviderType : belongs to
FinancialData ..> ProviderType : belongs to
NewsData ..> ProviderType : belongs to
SectorData ..> ProviderType : belongs to

