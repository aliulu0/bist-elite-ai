# ==========================================================
# BIST Elite Web - React/Vite Frontend
# ==========================================================

# Stage 1: Build (deps + compile in one stage for reliability)
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web ./apps/web
COPY packages ./packages
WORKDIR /app/apps/web
RUN pnpm run build

# Stage 2: Production runner (nginx)
FROM nginx:alpine AS runner

RUN addgroup --system --gid 1001 webgroup
RUN adduser --system --uid 1001 --ingroup webgroup webuser

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

RUN chown -R webuser:webgroup /usr/share/nginx/html
RUN chown -R webuser:webgroup /var/cache/nginx
RUN chown -R webuser:webgroup /var/log/nginx
RUN touch /var/run/nginx.pid && chown webuser:webgroup /var/run/nginx.pid

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
