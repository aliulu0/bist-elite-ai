# ==========================================================
# BIST Elite AI - Production Environment Variables
# ==========================================================
# NEVER commit this file. Copy to .env and fill in values.

# App
APP_NAME=BIST Elite AI
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=info

# Database (CHANGE THESE)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bist_elite_ai
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/bist_elite_ai

# Redis (CHANGE THESE)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# Auth (CHANGE THESE)
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=24h

# API
PORT=3001
CORS_ORIGINS=https://yourdomain.com

# Web
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# Worker
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_LOG_LEVEL=warning

# Telegram (REQUIRED for production)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
