[Unit]
Description=BIST Elite AI - Background Worker
Documentation=https://github.com/bist-elite-ai/bist-elite-ai
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=bist
Group=bist
WorkingDirectory=/opt/bist-elite-ai/apps/worker
EnvironmentFile=/opt/bist-elite-ai/.env
ExecStart=/opt/bist-elite-ai/apps/worker/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=120

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bist-elite-ai/logs

# Resource limits
LimitNOFILE=65535
MemoryMax=512M
CPUQuota=80%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bist-worker

[Install]
WantedBy=multi-user.target
